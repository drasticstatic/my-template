# ============================================================
# MASTER .gitignore TEMPLATE
# ============================================================
# Copy to repo root and remove sections that don't apply.
# Keep the "REPO-SPECIFIC" section at the bottom and add
# any paths unique to your project there.
#
# Rule of thumb:
#   - Secrets/credentials → always ignored, no exceptions
#   - Generated build artifacts → always ignored
#   - Personal/OS metadata → always ignored
#   - Working data (CSVs, logs) → decide per repo below
#
# Sources merged: trading-assistant · pir-devine-news ·
#   divorce-custody-assistant · dao · crowdsale · amm ·
#   nft_dappu-punks · gratitude-token-project ·
#   tradingview-mcp-jackson · robinhood-mcp
# ============================================================


# -----------------------------------------------
# macOS system files
# -----------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?
.fseventsd


# -----------------------------------------------
# macOS / iCloud aliases
# -----------------------------------------------
*alias
*alias/
*.icloud


# -----------------------------------------------
# Windows & Linux system files
# -----------------------------------------------
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/


# -----------------------------------------------
# Credentials, API keys, secrets
# (absolute — no exceptions)
# -----------------------------------------------
.env
.env.*
!.env.example
!.env.template
# CRA / framework-generated env variants
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
*.p12
*.pfx
credentials/
secrets/
keys/
*service_account*
*service-account*
*google-credentials*
*google_credentials*
*gspread*

# GWS CLI auth cache (Google Workspace CLI)
.gws/
gws-credentials*

# Robin stocks / brokerage session tokens
.tokens/

# MCP registry tokens
.mcpregistry_github_token
.mcpregistry_registry_token

# GitGuardian scan cache
.cache_ggshield

# JSON: blocked by default to prevent accidental credential commits.
# Add named exceptions below for config files your project needs.
*.json
!package.json
!package-lock.json
!tsconfig*.json
!.eslintrc.json
!.prettierrc.json
!gitexporter.config.json
!branch-protection/ruleset.json
!branch-protection/ruleset-public-preview.json
!graphify-out/graph.json
# Uncomment as needed:
# !hardhat.config.json
# !dashboard/data.json


# -----------------------------------------------
# Web3 wallet & on-chain secrets
# -----------------------------------------------
wallets/
keystore/
mnemonic*
seed*
*.json.secret


# -----------------------------------------------
# Python
# -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
*.egg
# Python packaging / distribution
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
.installed.cfg
dist/
build/
*.so
# Pip
pip-log.txt
pip-delete-this-directory.txt
# Package managers
Pipfile
Pipfile.lock
poetry.lock
uv.lock
.python-version
# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
# Linting
.ruff_cache/


# -----------------------------------------------
# Node.js / npm / yarn
# -----------------------------------------------
node_modules/
.npm/
.yarn/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.node_repl_history


# -----------------------------------------------
# Web3 / Solidity / Hardhat / Foundry
# -----------------------------------------------
artifacts/
cache/
typechain/
typechain-types/
.openzeppelin/
.hardhat-cache/
coverage/
coverage.json
ignition/deployments/chain-31337
out/
forge-cache/
*.abi


# -----------------------------------------------
# React / Next.js / Vite / Docusaurus
# -----------------------------------------------
.next/
.nuxt/
.docusaurus/
.vuepress/
public/build/
docs/build/
site/
_site/
build/
dist/
out/


# -----------------------------------------------
# Editor / IDE
# -----------------------------------------------
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.project
.classpath
.settings/


# -----------------------------------------------
# Logs & temp files
# -----------------------------------------------
*.log
*.tmp
*.temp
*.bak
temp_*
log/
tmp/
temp/


# -----------------------------------------------
# Test / coverage output
# -----------------------------------------------
/coverage
coverage/
.nyc_output/
*.lcov
__snapshots__/


# -----------------------------------------------
# Misc generated / binary
# -----------------------------------------------
*.class
*.o
*.so
*.dll
*.bin
*.exe


# -----------------------------------------------
# Claude Code local config
# Skills and .claude/*.md docs are tracked; everything else stays local
# -----------------------------------------------
.claude/*
!.claude/skills/
!.claude/skills-ran-through-makemyskill.com/
!.claude/settings.json
!.claude/POINTER.md
!.claude/settings.local.json.md


# ============================================================
# REPO-SPECIFIC SECTION
# ============================================================
# Add paths unique to this project below.
# Remove sections above that don't apply to your stack.

# Graphify — local-only outputs (graph.json, GRAPH_REPORT.md, graph.html are committed)
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/cache/
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.json
