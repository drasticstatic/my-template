#!/bin/sh
# commit-msg — guide the fleet commit-attribution convention.
#
# Advisory variant (from THEF, 2026-10-23): this copy WARNS and never rejects.
# Use it in any organization that welcomes people new to git. They (and the AI
# tools that commit for them) should never be blocked by a credit line, and
# nobody should need --no-verify. A commit without an AI trailer is recorded as
# a human's work. The secret scan in pre-commit is the hard stop. The strict
# (rejecting) hook lives in my-template/.githooks/commit-msg. Install as
# .githooks/commit-msg in the repository.
#
# Canonical form (see AGENT-SYNC/README.md — that file is the spec, this is the
# enforcement of it):
#
#     Co-Authored-By: <Agent> · <Engine> · <Provider> [<Model>]
#     Co-Authored-By: <Agent> · <Engine> · <Gateway> · <Provider> [<Model>]
#     <Platform>-Session: <full session URL>       (when the platform assigns one)
#
# Four layers, and the field order deliberately mirrors the free-claude-code
# model selector string, so the footer is a transcription and not a memory test:
#
#     anthropic / nvidia_nim / z-ai   / glm4.7
#       └ dialect  └ Gateway   └ Provider └ Model
#
#     Co-Authored-By: Alfred-NIM · ClaudeCodeCLI · NVIDIA NIM · Z.ai [GLM-4.7]
#
#     <Engine>   the harness you typed into     ClaudeCodeCLI, Cosmos, AugmentIntent
#     <Gateway>  what routed the request        NVIDIA NIM, OpenRouter   (omit if direct)
#     <Provider> whose weights ran              Anthropic, Z.ai, Moonshot AI, MiniMaxAI
#     <Model>    which weights                  Sonnet-5, GLM-4.7, Kimi-K2.5
#
# The Gateway is not the Provider. NVIDIA NIM routes; Z.ai makes GLM-4.7. Routing
# Claude Code through a proxy adds a Gateway and changes the Provider and Model —
# it never changes the Engine, because the harness is still the thing you typed into.
#
# Installed via core.hooksPath, so it is version-controlled and travels with the
# repo. Activate once per clone:  sh scripts/install-hooks.sh
#
# No escape hatch needed: human commits simply have no AI trailer.

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

# Strip comment lines so commented-out examples never satisfy the check.
BODY=$(grep -v '^#' "$MSG_FILE")

# Exempt machine-generated commits the author does not hand-write.
case "$BODY" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"Merge branch"*|"Merge pull request"*)
    exit 0 ;;
esac

# An empty message is git's own abort path — let git handle it.
printf '%s' "$BODY" | grep -q '[^[:space:]]' || exit 0

DIRECT='^Co-Authored-By: [^·]+ · [^·]+ · [^·]+ \[.+\]$'
GATED='^Co-Authored-By: [^·]+ · [^·]+ · [^·]+ · [^·]+ \[.+\]$'
ANY_COAUTHOR='^Co-Authored-By:'
SESSION='^[A-Za-z][A-Za-z0-9]*-Session: '

fail() {
  cat >&2 <<EOF

  ⓘ Commit credit: $1
    Commit allowed. If an AI helped write this change, credit it with one line:
      Co-Authored-By: <Agent> · <Engine> · <Provider> [<Model>]
    Examples:
      Co-Authored-By: Alfred · ClaudeCodeCLI · Anthropic [Opus-5.5]
      Co-Authored-By: Codex · CodexCloud · OpenAI [<model>]
      Co-Authored-By: Codex · CodexCLI · OpenAI [<model>]
      Co-Authored-By: ChatGPT · GitHubConnector · OpenAI [<model>]
      Co-Authored-By: Cosmos-Advisor · Cosmos · Anthropic [Claude Opus 5]
    The separator is the middle dot ( · ), the model goes in [square brackets],
    and a session link (Claude-Session: …) goes on its own line.
    Spec: https://github.com/drasticstatic/my-template/blob/main/AGENT-SYNC/README.md

EOF
  exit 0
}

if ! printf '%s\n' "$BODY" | grep -qE "$ANY_COAUTHOR"; then
  fail "no AI trailer, so this is recorded as a human commit."
fi

if printf '%s\n' "$BODY" | grep -qE "$GATED"; then
  FORM=gated
elif printf '%s\n' "$BODY" | grep -qE "$DIRECT"; then
  FORM=direct
else
  BAD=$(printf '%s\n' "$BODY" | grep -E "$ANY_COAUTHOR" | head -1)
  fail "found a Co-Authored-By: line that isn't in the usual form:
      $BAD"
fi

LINE=$(printf '%s\n' "$BODY" | grep -E "$ANY_COAUTHOR" | head -1)
MODEL=$(printf '%s' "$LINE" | sed -n 's/.*\[\(.*\)\]$/\1/p')
FIELDS=$(printf '%s' "$LINE" | sed 's/^Co-Authored-By: //; s/ *\[.*\]$//')

if [ "$FORM" = gated ]; then
  GATEWAY=$(printf '%s' "$FIELDS" | awk -F' · ' '{print $3}')
  PROVIDER=$(printf '%s' "$FIELDS" | awk -F' · ' '{print $4}')
else
  GATEWAY=""
  PROVIDER=$(printf '%s' "$FIELDS" | awk -F' · ' '{print $3}')
fi

warn() { printf '\n  ⚠ %s\n\n' "$1" >&2; }

# Models that only ever reach this fleet through a gateway.
PROXIED='glm|kimi|minimax|deepseek|qwen|llama|mistral|mixtral|gemma|phi-'
# Known provider for each, so the warning can name the right answer.
provider_for() {
  case "$1" in
    *[Gg][Ll][Mm]*)        echo "Z.ai" ;;
    *[Kk]imi*)             echo "Moonshot AI" ;;
    *[Mm]ini[Mm]ax*)       echo "MiniMaxAI" ;;
    *[Dd]eep[Ss]eek*)      echo "DeepSeek" ;;
    *[Qq]wen*)             echo "Alibaba" ;;
    *)                     echo "" ;;
  esac
}
EXPECTED=$(provider_for "$MODEL")

# 1. The mistake this hook exists to catch: naming the gateway as the provider.
# Matched whole-field, not by substring — "MiniMax" contains "nim".
# Gateways route to someone else's hardware. Local runtimes (Ollama, llama.cpp,
# LM Studio) are where the weights actually ran, so they are Providers, not gateways.
IS_GATEWAY='^(nvidia nim|nvidia|nim|openrouter|free-claude-code)$'
if [ -n "$EXPECTED" ] && printf '%s' "$PROVIDER" | grep -qiE "$IS_GATEWAY"; then
  warn "Provider says \"$PROVIDER\", but that is a gateway, not a provider.
    [$MODEL] comes from $EXPECTED. The gateway belongs in its own field:

      ... · ClaudeCodeCLI · $PROVIDER · $EXPECTED [$MODEL]

    Commit allowed, but the trailer credits the wrong party."
fi

# 2. Proxied model with no Gateway declared at all.
# Local runtimes are exempt: nothing routed the request, so there is no gateway.
IS_LOCAL='^(ollama|llama\.cpp|lm studio|vllm|localai|local)$'
if [ "$FORM" = direct ] && printf '%s' "$MODEL" | grep -qiE "$PROXIED" \
   && ! printf '%s' "$PROVIDER" | grep -qiE "$IS_LOCAL"; then
  warn "[$MODEL] does not run on Anthropic infrastructure, but no Gateway field
    is present. If you are on free-claude-code, this should read:

      ... · ClaudeCodeCLI · NVIDIA NIM · ${EXPECTED:-<Provider>} [$MODEL]

    Commit allowed, but the routing is unrecorded."
fi

# 3. Provider still says Anthropic while the model plainly is not.
if [ "$PROVIDER" = "Anthropic" ] && printf '%s' "$MODEL" | grep -qiE "$PROXIED"; then
  warn "Provider says Anthropic, but [$MODEL] is not an Anthropic model.
    This is the failure that hides — the Engine legitimately did not change when
    you switched models, so the line still looks right.
    Commit allowed, but the trailer is probably wrong."
fi

# 4. Anthropic weights behind the NIM gateway — never once worked on this fleet.
if [ "$FORM" = gated ] && [ "$PROVIDER" = "Anthropic" ]; then
  warn "Gateway \"$GATEWAY\" with Provider Anthropic. No Anthropic model has ever
    successfully served through this proxy — only GLM, Kimi and MiniMax have.
    An Anthropic-model session is almost certainly direct, so drop the Gateway
    field. Commit allowed in case that has changed."
fi

# 5. Fleet policy: the proxy is Alfred's. Fortuna and Mystarch stay on Anthropic.
# Warned, never rejected — the footer records what happened, and a hook that
# blocks an honest record only encourages a dishonest one.
AGENT=$(printf '%s' "$FIELDS" | awk -F' · ' '{print $1}')
if [ "$FORM" = gated ] && printf '%s' "$AGENT" | grep -qiE '^(fortuna|mystarch)'; then
  warn "$AGENT is recorded as running through gateway \"$GATEWAY\".
    Fleet policy keeps the proxy to Alfred: Fortuna and Mystarch run on Anthropic.
    Fortuna touches live trading, where quality is not tradeable.
    If this is accurate, leave it — an honest footer beats a tidy one — but the
    session itself was probably launched the wrong way."
fi

# Session trailer is advisory: not every engine assigns a session ID.
if ! printf '%s\n' "$BODY" | grep -qE "$SESSION"; then
  cat >&2 <<'EOF'

  ⚠ No <Platform>-Session: trailer. Allowed — but if your engine assigns a
    session or conversation ID, add it so this commit stays traceable to the
    run that produced it.

EOF
fi

exit 0
