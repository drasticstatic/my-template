    text-transform: uppercase;
    color: var(--muted);
  }
  .lg-prio {
    --p: #8a8f98;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    margin-right: 0.45rem;
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--p) 16%, transparent);
    color: color-mix(in srgb, var(--p) 72%, var(--foreground));
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
    vertical-align: 0.08em;
  }
  .lg-prio[data-p="critical"] {
