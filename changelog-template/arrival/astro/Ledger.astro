---
// Arrival kit · the ledger's body (v2): a calm, filterable record of commits, grouped by month, day
// and repository. Canonical copy: drasticstatic/my-template changelog-template/arrival/astro/
// Ledger.astro. Copy unchanged; the page around it (src/pages/ledger.astro) supplies the heading,
// the intro and the site layout. Styling uses only the kit's tokens, so it takes each org's lights.
//
//   ---
//   import Ledger from "../components/Ledger.astro";
//   import { loadLedger } from "../ledger/ledger.mjs";
//   import { LEDGER } from "../data/ledger.config.mjs";
//   const ledger = await loadLedger(LEDGER);
//   ---
//   <Ledger ledger={ledger} colors={WEDGES} openMonths={2} />
//
// Every public row links to the commit on GitHub (so the arrival kit's "what's new" marks the ones
// newer than the visitor's last visit and fills the New tag). A private row (v2) is masked and links
// nowhere: repository, day, time, kind and priority only. Each row: kind, priority badge, summary,
// then the person (first name + last initial, linked to their GitHub profile; a generated picture
// when they ask for one), and an agent row when an AI co-authored it ("with Alfred · Claude Code").
interface Props {
  ledger: any;
  /** One color per kind, in the ledger's kind order (an org's wedge colors work well). */
  colors?: string[];
  /** How many months start open. */
  openMonths?: number;
  /** The word before the agents, e.g. "with" in "with Alfred · Claude Code". */
  withWord?: string;
}
const { ledger, colors = ["#7c6cf2", "#c46be0", "#e07a9b", "#e39b4e", "#c9b648", "#6fbf5a", "#45b8c9", "#7b8ba6", "#a08bd8"], openMonths = 2, withWord = "with" } = Astro.props;
const kindColor: Record<string, string> = {};
(ledger.kinds ?? []).forEach((k: any, i: number) => (kindColor[k.id] = colors[i % colors.length]));
const fmt = (d?: string | null) =>
  d ? new Date(`${d}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }) : "";
const generated = ledger.generated
  ? new Date(ledger.generated).toLocaleString("en-US", { month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit", timeZone: ledger.timeZone ?? "UTC", timeZoneName: "short" })
  : null;
const f = ledger.filtered ?? {};
const pub = ledger.shownPublic ?? ledger.shown;
const priv = ledger.shownPrivate ?? 0;
const pubRepos = (ledger.repos ?? []).filter((r: any) => !r.private).length;
const privRepos = (ledger.repos ?? []).filter((r: any) => r.private).length;
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
// v1 snapshots: `github` was the picture and `with` the co-authors.
const pictureOf = (who: any) => (who.avatar ? (who.avatar === "github" ? who.github : undefined) : who.github) ?? undefined;
const agentsOf = (it: any): string[] => (it.agents ? it.agents.map((a: any) => a.label) : it.with ?? []);
const left = [
  f.merges ? `${f.merges} ${f.merges === 1 ? "merge" : "merges"}` : "",
  f.mirrors ? `${f.mirrors} automatic ${f.mirrors === 1 ? "publish" : "publishes"}` : "",
  f.bots ? `${f.bots} bot ${f.bots === 1 ? "chore" : "chores"}` : "",
  f.undone ? `${f.undone} ${f.undone === 1 ? "change" : "changes"} that cancelled out (a change and its undo)` : "",
  f.copies ? `${f.copies} private ${f.copies === 1 ? "change" : "changes"} already shown through a public copy` : "",
].filter(Boolean);
---

<div class="lg" data-ledger>
  {
    ledger.shown > 0 ? (
      <>
        <p class="lg-summary">
          <strong>{plural(pub, "public change", "public changes")}</strong> across {plural(pubRepos, "repository", "repositories")}, from {fmt(ledger.first)} to {fmt(ledger.last)}.
          {priv > 0 && <span> Also <strong>{plural(priv, "private change", "private changes")}</strong> in {plural(privRepos, "private repository", "private repositories")}, shown masked: where and when the work happened and what kind it was, never its words.</span>}
          {left.length > 0 && <span> Left out as noise: {left.join(", ")}.</span>}
          {generated && <span class="lg-fresh"> Gathered {generated}{ledger.from === "snapshot" ? " (from the saved copy; the live fetch was unavailable)" : ""}.</span>}
        </p>

        <div class="lg-filters" role="group" aria-label="Filter the ledger">
          <div class="lg-kinds" role="group" aria-label="Kinds of change">
            <button type="button" class="lg-chip arr-shape" data-lg-kind="all" aria-pressed="true">All kinds</button>
            {ledger.kinds.map((k: any) => (
              <button type="button" class="lg-chip arr-shape" data-lg-kind={k.id} aria-pressed="false" style={`--k:${kindColor[k.id]}`}>
                <i class={`ph ph-${k.icon}`} aria-hidden="true"></i>
                {k.name}
                <span class="lg-n">{k.count}</span>
              </button>
            ))}
          </div>
          <div class="lg-row-tools">
            <label class="lg-select">
              <span class="arr-sr">Repository</span>
              <select data-lg-repo>
                <option value="all">Every repository</option>
                {privRepos > 0 && <option value="@public">Public repositories</option>}
                {privRepos > 0 && <option value="@private">Private work (masked)</option>}
                {ledger.repos.map((r: any) => (
                  <option value={r.name}>{r.label}{r.private ? " · private" : ""} ({r.count})</option>
                ))}
              </select>
            </label>
            <label class="lg-search">
              <span class="arr-sr">Search the ledger</span>
              <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
              <input type="search" placeholder="Search words, people, places" data-lg-q />
            </label>
          </div>
          <p class="lg-count" aria-live="polite" data-lg-count></p>
        </div>

        {ledger.months.map((m: any, mi: number) => (
          <details class="lg-month" open={mi < openMonths} data-lg-month>
            <summary>
              <i class="ph ph-caret-right lg-caret" aria-hidden="true"></i>
              <span class="lg-month-name">{m.label}</span>
              <span class="lg-month-n" data-lg-month-n>{m.count} {m.count === 1 ? "change" : "changes"}</span>
            </summary>
            {m.days.map((day: any) => (
              <section class="lg-day" data-lg-day id={`d-${day.date}`}>
                <h3 class="lg-day-name"><time datetime={day.date}>{day.label}</time></h3>
                {day.groups.map((g: any) => (
                  <div class="lg-group" data-lg-group>
                    <p class="lg-repo">
                      <i class={`ph ph-${g.private ? "lock-simple" : "folder-simple"}`} aria-hidden="true"></i>
                      {g.label}
                      {g.private && <span class="lg-private" title="A private repository: each change shows when it happened and what kind it was, never its words">private</span>}
                    </p>
                    <ul class="lg-items">
                      {g.items.map((it: any) => (
                        <li
                          class:list={["lg-item", { "lg-has-agents": agentsOf(it).length > 0, "lg-item-private": it.private }]}
                          data-lg-item
                          data-kind={it.kind.id}
                          data-repo={it.repo}
                          data-private={it.private ? "1" : "0"}
                          data-text={`${it.masked ? "private masked" : it.text} ${it.area ?? ""} ${it.kind.name} ${it.priority ? `${it.priority.name} priority` : ""} ${it.who.name} ${agentsOf(it).join(" ")} ${it.repoLabel} ${it.private ? "private" : ""} ${it.short}`.toLowerCase()}
                          style={`--k:${kindColor[it.kind.id]}`}
                        >
                          <span class="lg-kind" title={it.kind.name}>
                            <i class={`ph ph-${it.kind.icon}`} aria-hidden="true"></i>
                            <span class="lg-kind-name">{it.kind.name}</span>
                          </span>
                          {it.url ? (
                            <a class="lg-text" href={it.url}>
                              {it.priority && <span class="lg-prio" data-p={it.priority.id} title={`Priority: ${it.priority.name.toLowerCase()}`}><i class={`ph ph-${it.priority.icon}`} aria-hidden="true"></i>{it.priority.name}</span>}
                              {it.area && <span class="lg-area">{it.area}</span>}
                              {it.text}
                              <span data-arr-new-tag hidden></span>
                            </a>
                          ) : (
                            <span class="lg-text lg-text-private">
                              {it.priority && <span class="lg-prio" data-p={it.priority.id} title={`Priority: ${it.priority.name.toLowerCase()}`}><i class={`ph ph-${it.priority.icon}`} aria-hidden="true"></i>{it.priority.name}</span>}
                              {it.area && <span class="lg-area">{it.area}</span>}
                              {it.masked ? <span class="lg-mask" aria-hidden="true">{it.text}</span> : it.text}
                              {it.masked && <span class="arr-sr">A private change; its description stays private.</span>}
                              <span data-arr-new-tag hidden></span>
                            </span>
                          )}
                          <span class="lg-meta">
                            <arrival-avatar name={it.who.name} github={pictureOf(it.who)} size={18} />
                            {it.who.github ? <a class="lg-who" href={`https://github.com/${it.who.github}`}>{it.who.name}</a> : <span class="lg-who">{it.who.name}</span>}
                            <span aria-hidden="true">·</span>
                            <time datetime={it.ts}>{it.time}</time>
                            <span aria-hidden="true">·</span>
                            <code title={it.private ? "The change's id (a private repository, so no link)" : "The change's id on GitHub"}>{it.short}</code>
                          </span>
                          {agentsOf(it).length > 0 && (
                            <span class="lg-agents">
                              <i class="ph ph-robot" aria-hidden="true"></i>
                              {withWord} {agentsOf(it).join(", ")}
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </section>
            ))}
          </details>
        ))}
        <p class="lg-empty" data-lg-empty hidden>No changes match. Choose All kinds, every repository, or clear the search.</p>
      </>
    ) : (
      <p class="lg-summary">The ledger couldn't be gathered for this build. It refreshes every day; check back soon.</p>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ledger]").forEach((root) => {
    const chips = root.querySelectorAll<HTMLButtonElement>("[data-lg-kind]");
    const repo = root.querySelector<HTMLSelectElement>("[data-lg-repo]");
    const q = root.querySelector<HTMLInputElement>("[data-lg-q]");
    const count = root.querySelector<HTMLElement>("[data-lg-count]");
    const empty = root.querySelector<HTMLElement>("[data-lg-empty]");
    const items = root.querySelectorAll<HTMLElement>("[data-lg-item]");
    if (!repo || !q) return;
    let kinds = new Set<string>();
    const apply = () => {
      const text = q.value.trim().toLowerCase();
      const words = text.split(/\s+/).filter(Boolean);
      let shown = 0;
      items.forEach((li) => {
        const ok =
          (!kinds.size || kinds.has(li.dataset.kind ?? "")) &&
          (repo.value === "all" ||
            (repo.value === "@public" && li.dataset.private !== "1") ||
            (repo.value === "@private" && li.dataset.private === "1") ||
            li.dataset.repo === repo.value) &&
          words.every((w) => li.dataset.text?.includes(w));
        li.hidden = !ok;
        if (ok) shown++;
      });
      root.querySelectorAll<HTMLElement>("[data-lg-group], [data-lg-day]").forEach((box) => {
        box.hidden = !box.querySelector("[data-lg-item]:not([hidden])");
      });
      const filtering = kinds.size > 0 || repo.value !== "all" || words.length > 0;
      root.querySelectorAll<HTMLDetailsElement>("[data-lg-month]").forEach((m) => {
        const n = m.querySelectorAll("[data-lg-item]:not([hidden])").length;
        m.hidden = n === 0;
        const label = m.querySelector<HTMLElement>("[data-lg-month-n]");
        if (label) label.textContent = `${n} ${n === 1 ? "change" : "changes"}`;
        if (filtering && n) m.open = true;
      });
      if (count) count.textContent = filtering ? `Showing ${shown} of ${items.length}` : "";
      if (empty) empty.hidden = shown > 0;
    };
    chips.forEach((b) =>
      b.addEventListener("click", () => {
        const k = b.dataset.lgKind ?? "all";
        if (k === "all") kinds = new Set();
        else if (kinds.has(k)) kinds.delete(k);
        else kinds.add(k);
        chips.forEach((c) => {
          const id = c.dataset.lgKind ?? "all";
          c.setAttribute("aria-pressed", String(id === "all" ? kinds.size === 0 : kinds.has(id)));
        });
        apply();
      })
    );
    repo.addEventListener("change", apply);
    q.addEventListener("input", apply);
  });
</script>

<style>
  .lg {
    --lg-gap: 0.9rem;
  }
  .lg-summary {
    max-width: 46rem;
    margin: 0 0 1.4rem;
    color: var(--foreground);
  }
  .lg-summary strong {
    color: var(--heading);
  }
  .lg-fresh {
    color: var(--muted);
  }
  .lg-filters {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1.75rem;
  }
  .lg-kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .lg-chip {
    --arr-cut: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 34px;
    padding: 0.35rem 0.75rem;
    border: 0;
    background: var(--surface-muted);
    color: var(--foreground);
    font: 600 0.84rem/1.2 var(--font-body);
    cursor: pointer;
  }
  .lg-chip .ph {
    color: var(--k, var(--accent));
    font-size: 1rem;
  }
  .lg-chip:hover {
    background: var(--border);
  }
  .lg-chip[aria-pressed="true"] {
    background: var(--accent);
    color: var(--on-accent);
  }
  .lg-chip[aria-pressed="true"] .ph {
    color: var(--on-accent);
  }
  .lg-chip:focus-visible,
  .lg-select select:focus-visible,
  .lg-search input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .lg-n {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }
  .lg-row-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .lg-select select,
  .lg-search input {
    min-height: 38px;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--foreground);
    font: inherit;
    font-size: 0.92rem;
  }
  .lg-search {
    position: relative;
    flex: 1 1 16rem;
    display: flex;
  }
  .lg-search .ph {
    position: absolute;
    left: 0.7rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
  }
  .lg-search input {
    width: 100%;
    padding-left: 2.1rem;
  }
  .lg-count {
    margin: 0;
    min-height: 1.2em;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .lg-month {
    margin: 0 0 1rem;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .lg-month > summary {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.85rem 1.1rem;
    cursor: pointer;
    list-style: none;
  }
  .lg-month > summary::-webkit-details-marker {
    display: none;
  }
  .lg-caret {
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .lg-month[open] .lg-caret {
    transform: rotate(90deg);
  }
  .lg-month-name {
    font-family: var(--font-heading);
    font-variation-settings: var(--heading-settings);
    font-size: 1.35rem;
    color: var(--heading);
  }
  .lg-month-n {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .lg-day {
    padding: 0.2rem 1.1rem 0.9rem;
  }
  .lg-day + .lg-day {
    border-top: 1px dashed var(--border);
    padding-top: 0.9rem;
  }
  .lg-day-name {
    margin: 0 0 0.5rem;
    font: 700 0.74rem/1.2 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lg-group + .lg-group {
    margin-top: 0.6rem;
  }
  .lg-repo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.25rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--heading);
  }
  .lg-repo .ph {
    color: var(--accent);
  }
  .lg-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lg-item {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.1rem var(--lg-gap);
    align-items: baseline;
    padding: 0.4rem 0;
  }
  .lg-item + .lg-item {
    border-top: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
  }
  .lg-kind {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    grid-row: span 2;
    align-self: start;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }
  .lg-kind .ph {
    display: inline-grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--k) 22%, transparent);
    color: var(--k);
    font-size: 0.95rem;
    flex: none;
  }
  .lg-text {
    color: var(--foreground);
    text-decoration: none;
    line-height: 1.45;
  }
  .lg-text:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .lg-has-agents .lg-kind {
    grid-row: span 3;
  }
  .lg-text-private:hover {
    color: var(--foreground);
    text-decoration: none;
  }
  .lg-mask {
    color: color-mix(in srgb, var(--muted) 70%, transparent);
    letter-spacing: -0.02em;
    word-spacing: 0.15em;
    user-select: none;
  }
  .lg-private {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
