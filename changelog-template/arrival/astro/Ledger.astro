  }
  .lg-who {
    color: inherit;
    text-decoration: none;
  }
  a.lg-who:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .lg-agents {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .lg-agents .ph {
    color: var(--k, var(--accent));
  }
  .lg-text[data-arr-new] {
    margin-left: -0.5rem;
    padding-left: 0.5rem;
  }
  .lg-area {
    margin-right: 0.45rem;
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    background: var(--surface-muted);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--heading);
    white-space: nowrap;
  }
  .lg-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .lg-meta code {
    font: 0.76rem/1 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }
  .lg-empty {
    color: var(--muted);
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 640px) {
    .lg-item {
      grid-template-columns: minmax(0, 1fr);
    }
    .lg-kind,
    .lg-has-agents .lg-kind {
      grid-row: auto;
    }
    .lg-day {
      padding-left: 0.8rem;
      padding-right: 0.8rem;
    }
  }
</style>
