---
// /roadmap: the repository's ROADMAP.md, as a page (kit 1.2).
import Base from "../layouts/Base.astro";
import RepoDoc from "../components/RepoDoc.astro";
import { NAME } from "../data/site";
import { pageCardUrl } from "../og/pages";
---

<Base title={`Roadmap — ${NAME} AstroLog`} description={`Where ${NAME}'s GitHub home is headed next, in rough order and without dates.`} active="roadmap" ogImage={pageCardUrl("roadmap")} ogAlt={`${NAME}'s roadmap: what comes next, beside a spore print.`}>
  <RepoDoc doc="roadmap" />
</Base>
